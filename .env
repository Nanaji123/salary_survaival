EXPO_PUBLIC_CONVEX_URL=https://adamant-ostrich-419.convex.cloud

# RevenueCat public SDK key. The test_ key uses RevenueCat's Test Store on both platforms.
# Before release, set EXPO_PUBLIC_REVENUECAT_IOS_KEY (appl_...) and
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY (goog_...); they take priority over this one.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_tQrcXccuRVEraMFoIFgBBFRprBJ

# Subscriptions and free-plan limits. Keep false until the products exist in App Store Connect,
# Play Console and RevenueCat; with false everyone gets the full app and no paywall is shown.
EXPO_PUBLIC_SUBSCRIPTIONS_ENABLED=false

# Store review requires a hosted privacy policy, served by convex/http.ts.
EXPO_PUBLIC_PRIVACY_URL=https://adamant-ostrich-419.convex.site/privacy
# Optional: your own terms page. Defaults to Apple's standard EULA.
EXPO_PUBLIC_TERMS_URL=
# Support contact shown in Settings.
EXPO_PUBLIC_SUPPORT_EMAIL=gundapunanaji123@gmail.com
